/site/
.vite/
dist/
build/
out/

# Temp / cache
.tmp/
.temp/
.cache/
.eslintcache

# Bun
bun.lockb

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

