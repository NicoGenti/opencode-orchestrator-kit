{
  "name": "opencode-orchestrator-kit-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.21",
  "description": "Static landing page for the opencode-orchestrator-kit project, built with Vite + React + Tailwind and deployed to GitHub Pages.",
  "scripts": {
    "dev:docs": "vite --config vite.docs.config.ts",
    "build:docs": "vite build --config vite.docs.config.ts && node scripts/prepare-pages.mjs",
    "build": "bun run build:docs",
    "preview": "vite preview --config vite.docs.config.ts --outDir site",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "@tailwindcss/vite": "4.0.17",
    "@types/node": "^26.4.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "eslint": "9.13.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "globals": "15.11.0",
    "prettier": "3.3.3",
    "tailwindcss": "4.0.17",
    "typescript": "5.6.3",
    "typescript-eslint": "8.11.0",
    "vite": "5.4.10",
    "vite-tsconfig-paths": "5.0.1",
    "@types/bun": "latest"
  }
}
