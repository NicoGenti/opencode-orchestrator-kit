{
  "name": "opencode-orchestrator-kit-site",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.21",
  "description": "Static landing page for the opencode-orchestrator-kit project, built with Vite + React + Tailwind and deployed to GitHub Pages.",
  "scripts": {
    "dev:docs": "vite --config vite.docs.config.ts",
    "build:docs": "vite build --config vite.docs.config.ts && node scripts/prepare-pages.mjs",
    "build": "bun run build:docs",
    "preview": "vite preview --config vite.docs.config.ts --outDir site",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "sync-assets": "bun scripts/sync-assets.ts",
    "bump-version": "bun scripts/bump-version.ts",
    "bun:audit": "bun test && bun run lint"
  },
  "dependencies": {
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "latest",
    "@types/node": "^26.4.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "prettier": "3.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.72.1",
    "vite": "5.4.10",
    "vite-tsconfig-paths": "6.1.1"
  }
}
